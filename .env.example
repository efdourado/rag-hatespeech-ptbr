# Copie para .env. Nunca compartilhe ou versione a chave.
OPENROUTER_API_KEY=
# Escolha um ID fixo :free com saída estruturada, depois de conferir o catálogo.
OPENROUTER_CHAT_MODEL=
# Embeddings locais permitem usar RAG sem cobrança de uma API de embeddings.
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Revisão fixada do modelo acima.
LOCAL_EMBEDDING_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
# Alternativa via OpenRouter: escolha o modelo e confira o preço antes de usar.
OPENROUTER_EMBEDDING_MODEL=
# Opcional: restringir ambos os endpoints a um provedor específico.
OPENROUTER_CHAT_PROVIDER=
OPENROUTER_EMBEDDING_PROVIDER=
